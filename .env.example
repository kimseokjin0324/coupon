# 로컬 개발 환경 변수 (이 파일을 .env로 복사해서 사용)

# MySQL (docker-compose.yml에서 사용)
MYSQL_ROOT_PASSWORD=your-strong-root-password-here
MYSQL_PASSWORD=your-app-password-here

# Database (IntelliJ 로컬 실행용)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/coupon
SPRING_DATASOURCE_USERNAME=coupon
SPRING_DATASOURCE_PASSWORD=your-app-password-here

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# 캐시 설정 (stampede 테스트용 짧은 TTL)
COUPON_CACHE_TTL_MS=1000
COUPON_CACHE_FRESH_MS=500
COUPON_CACHE_SIMULATED_LOAD_LATENCY_MS=100

# 매진 플래그
COUPON_SOLD_OUT_TTL_SECONDS=86400
COUPON_SOLD_OUT_FAST_PATH_TTL_MS=1000
